# ===== 银发哨兵 v1.0 配置示例 =====
# 复制为 .env 后修改。所有项都有合理默认值，全部留空也能运行。
# 原则：每个可选能力都必须能关掉，关掉之后系统仍然工作——这是长期无人值守的前提。

# ---------------------------------------------------------------- 存储
SILVER_DATA_DIR=./data
# 换 Postgres 时填写；留空则用 SQLite（单机长期运行推荐 SQLite + 异地副本）
# SILVER_DB_URL=postgresql+psycopg://user:pass@localhost:5432/sentinel

# ---------------------------------------------------------------- 网络
# 置 0 则完全离线：只跑本地规则，不查任何外部情报源（适合内网部署与测试）
SILVER_ALLOW_NETWORK=1
SILVER_HTTP_TIMEOUT=12
SILVER_HTTP_RETRIES=2
SILVER_RATE_LIMIT=2

# ---------------------------------------------------------------- LLM（OpenAI 兼容接口，可选）
# 不配置也能用：规则引擎是主判据，LLM 只负责把证据串成叙事。
SILVER_LLM_ENABLED=1
# SILVER_LLM_BASE_URL=https://api.deepseek.com/v1
# SILVER_LLM_API_KEY=sk-your-key
# SILVER_LLM_MODEL=deepseek-chat
SILVER_LLM_TIMEOUT=45

# ---------------------------------------------------------------- 外部情报
# abuse.ch 免费申请：https://auth.abuse.ch/
# URLHAUS_AUTH_KEY=
# OPENPHISH_FEED=https://openphish.com/feed.txt

# ================================================================
# 发现层（v1.0 新增）
# ================================================================
SILVER_DISCOVER_ENABLED=1
# 主路：直连 CT log 的 RFC 6962 接口轮询。逗号分隔，留空用内置日志集
# （按国内可达性排序：Cloudflare Nimbus / Let's Encrypt Oak / Google Xenon ...）
# SILVER_CT_POLL_LOGS=https://ct.cloudflare.com/logs/nimbus2025,https://oak.ct.letsencrypt.org/2025h2/
SILVER_CT_POLL_INTERVAL=60
SILVER_CT_POLL_BATCH=256
# 补强路：certstream WebSocket。公共实例常断流，可自建 certstream-server-go
SILVER_CT_STREAM_ENABLED=1
# SILVER_CT_STREAM_URL=wss://certstream.calidog.io/

# 准入线：命中几个词根才入库。1 = 宁可错杀
SILVER_DISCOVER_MIN_HITS=1
# 冷存保留天数（判定为明显无关后仍留档，便于回溯误杀）
SILVER_COLD_RETENTION_DAYS=180
# 待研判队列上限，防止一次 CT 风暴打爆内存
SILVER_DISCOVER_QUEUE=50000
# 同一注册域下的多主机归并成一个资产（主机清单留在 meta.hosts）
# 关掉会得到更细的粒度，但富化配额会被 www/分站 吃掉一半
SILVER_DISCOVER_COLLAPSE_SUBDOMAINS=1

# ================================================================
# ICP 备案判定（过滤噪音的关键一环）
# ================================================================
SILVER_ICP_ENABLED=1
# 支持 icpquery-mcp / ICP_Query_lite / WebScan 等任一本地服务，形如：
# SILVER_ICP_API=http://127.0.0.1:16181
# 未配置时 ICP 判定记为 unknown（不是「未备案」），不会污染评分
# 每分钟查询上限。工信部接口对频率敏感，无节制会触发封禁
SILVER_ICP_RPM=10
SILVER_ICP_CACHE_DAYS=30
SILVER_ICP_TIMEOUT=20
# 只对这些分级的目标查备案，避免无差别扫描被运营商盯上
SILVER_ICP_TIERS=candidate,watch,confirmed
# 同时查工信部「违法违规域名」名单（blackListLevel<2 视为已列管）
# 这是官方定性依据，比「有没有备案」更硬，代价是每次多一次请求
SILVER_ICP_VIOLATION=1
# 单次超时：验证码重试时可能 30 秒以上，别设太短
# SILVER_ICP_TIMEOUT=60

# ================================================================
# 关系图谱
# ================================================================
SILVER_GRAPH_ENABLED=1
# 留空 = 内置 SQLite 图引擎（零依赖）；填 bolt://... 则写 Neo4j
# SILVER_NEO4J_URI=bolt://127.0.0.1:7687
# SILVER_NEO4J_USER=neo4j
# SILVER_NEO4J_PASSWORD=changeme
# SILVER_NEO4J_DATABASE=neo4j
# 社区发现的最小团规模（单点不成团）
SILVER_GRAPH_MIN_COMMUNITY=2

# ================================================================
# 沙箱（真实执行网页 / APK）
# ================================================================
SILVER_SANDBOX_ENABLED=1
SILVER_SANDBOX_BROWSER=1
SILVER_SANDBOX_TIMEOUT=45
SILVER_SANDBOX_MAX_REDIRECTS=12
# 永远不要在生产打开这个：会允许沙箱访问内网地址（SSRF）
SILVER_SANDBOX_ALLOW_PRIVATE=0
# MobSF REST（可选）。留空则 APK 走静态行为推演，并如实标注 static-inference
# SILVER_MOBSF_URL=http://127.0.0.1:8000
# SILVER_MOBSF_KEY=
# adb/emulator 串号（可选）
# SILVER_ANDROID_SERIAL=emulator-5554

# ================================================================
# 异地副本（证据不因单机损毁而丢失）
# ================================================================
SILVER_REPLICA_ENABLED=0
# dir | s3 | webdav
SILVER_REPLICA_BACKEND=dir
# dir: /mnt/backup/silver   s3: http://minio:9000   webdav: https://dav.example/silver
SILVER_REPLICA_TARGET=
SILVER_REPLICA_INTERVAL=300
# SILVER_REPLICA_ACCESS_KEY=
# SILVER_REPLICA_SECRET_KEY=
SILVER_REPLICA_BUCKET=silver-sentinel
# 回读校验：写完再读一遍比对大小，防静默损坏
SILVER_REPLICA_VERIFY=1
# WebDAV 后端的账号密码复用 ACCESS_KEY / SECRET_KEY 两项

# ---------------------------------------------------------------- 判定策略
# 置 1：没有官方通报或人工复核时，机器最高只判到「高度可疑」
SILVER_CONFIRM_REQUIRES_OFFICIAL=1
SILVER_MIN_SIGNALS=2

# ---------------------------------------------------------------- 扩展
# 外挂规则文件（按 id 覆盖内置规则）
# SILVER_RULES_PATH=./my_rules.yaml

# ---------------------------------------------------------------- 调度
# 置 1 时进程内启动发现引擎 + 周期调度（单进程部署选这个）
SILVER_AUTOSTART_MONITOR=0
SILVER_MONITOR_TICK=60
SILVER_MONITOR_BATCH=40
SILVER_WATCH_INTERVAL=360
SILVER_WORKERS=8
SILVER_SCHEDULER_IN_PROCESS=1

# ---------------------------------------------------------------- 运维
SILVER_LOG_LEVEL=INFO
# 置 1 输出单行 JSON 日志，便于 Loki/ELK 采集
SILVER_LOG_JSON=0
SILVER_METRICS_ENABLED=1
SILVER_STREAM_HEARTBEAT=15

# ================================================================
# 出站防护（OPSEC）：不让对手看见「谁在查我」
# ================================================================
SILVER_OPSEC_ENABLED=1
# 0 = fail-closed：没有代理就绝不直连可疑目标（生产建议）
# 1 = 允许直连，但运维页会标红「出口未隔离」
SILVER_OPSEC_ALLOW_DIRECT=0
# 代理池，逗号分隔。socks5h 表示由代理解析 DNS（不泄露本地解析）
# SILVER_OPSEC_PROXIES=socks5h://user:pass@10.0.0.5:1080,http://10.0.0.6:3128
SILVER_OPSEC_PROXIES=
# 采集机对外 IP（留空自动探测网卡），用于在证据/举报材料里抹除
SILVER_OPSEC_OWN_IPS=
# 额外需要抹除的标识：机构名、运维邮箱、内网域名，逗号分隔
SILVER_OPSEC_IDENTIFIERS=
# 追加禁访后缀（默认已包含 gov.cn / edu.cn / 监管与 CA 域名）
SILVER_OPSEC_DENY_SUFFIXES=
# 沙箱浏览器没有隔离出口时直接拒绝运行（强烈建议保持 1）
SILVER_OPSEC_REQUIRE_PROXY_SANDBOX=1
# 一次性探针串，用于识别反射型蜜罐
SILVER_OPSEC_CANARY=1

# ================================================================
# 加密证据仓（原始证据加密存放；账本可进 Git）
# ================================================================
SILVER_VAULT_ENABLED=0
# dir | s3 | webdav | ipfs
SILVER_VAULT_BACKEND=dir
# dir: /mnt/private/vault   s3: https://oss.example   webdav: https://dav.example/vault
# ipfs: http://127.0.0.1:5001（Kubo RPC，自动 pin，去中心化分发）
SILVER_VAULT_TARGET=
SILVER_VAULT_NODE_ID=
SILVER_VAULT_INTERVAL=120
# 32 字节 base64 主密钥。优先用密钥文件或口令，不要写进命令行历史
# SILVER_VAULT_KEY=
SILVER_VAULT_KEY_FILE=
# 口令派生（scrypt）；多设备使用同一口令即可互通
# SILVER_VAULT_PASSPHRASE=
SILVER_VAULT_ACCESS_KEY=
SILVER_VAULT_SECRET_KEY=
SILVER_VAULT_BUCKET=silver-sentinel-vault
# 上传校验成功后删除本地明文（只留密文）
SILVER_VAULT_REMOVE_PLAINTEXT=0

# ================================================================
# 半自动举报（浏览器扩展取「填什么」）
# ================================================================
# 举报人署名与回执邮箱；12377 会自动带出登录账号的实名信息，这里主要给 12321 与 abuse 邮件用
SILVER_REPORT_REPORTER=
SILVER_REPORT_EMAIL=
SILVER_REPORT_PHONE=
# 扩展访问令牌。留空时只允许本机回环地址（127.0.0.1 / ::1）取数
# 部署在服务器上、浏览器不在同一台机器时务必设置
SILVER_REPORT_EXTENSION_TOKEN=
# 扩展下载证据包用的对外地址；留空则取前端请求的 Origin
SILVER_REPORT_API_BASE=
# 证据包里最多带几张截图（12377 附件总量上限 200MB / 10 个）
SILVER_REPORT_MAX_SHOTS=6
